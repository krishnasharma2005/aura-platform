# Copy this file to .env and fill in real values for local development.

# development | test | staging | production
ENV=development

# Async Postgres connection string (asyncpg driver). Matches the credentials
# in infra/docker-compose.yml by default — change only if you're pointing at
# a different database.
DATABASE_URL=postgresql+asyncpg://aura:aura_dev_password@localhost:5432/aura

# Redis, used for short-term conversation memory.
REDIS_URL=redis://localhost:6379/0

# Secret used to sign JWTs — generate a real random value for anything beyond
# local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# Encrypts integration access/refresh tokens at rest (src/core/crypto.py).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in local dev (tokens are stored as-is and a warning is logged).
# The API REFUSES TO START in production without it.
ENCRYPTION_KEY=

# IANA timezone used for calendar reads/writes when an organization hasn't set
# its own (organizations.timezone). "Tuesday at 3pm" is booked in this zone.
DEFAULT_TIMEZONE=UTC

# Largest knowledge-base document accepted by POST /knowledge/upload, in bytes.
MAX_UPLOAD_BYTES=20971520

# FOUNDER MUST PROVIDE: an OpenAI API key (https://platform.openai.com/api-keys).
# Without this, AI-calling endpoints (agent chat, knowledge search/ingest)
# return a clean "not set up yet" error instead of crashing — everything else
# in the API works without it.
OPENAI_API_KEY=

# --- Third-party integrations used by tools/*.py ---
# None of these are read directly from env by the app (tokens are stored per
# organization in the `integrations` table via POST /api/v1/integrations),
# but a real OAuth/app setup is required before any customer can connect them.
# See docs/needs-founder-input.md for exactly what's needed and why.

# FOUNDER MUST PROVIDE: Google Cloud OAuth app (Calendar + Gmail scopes).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# FOUNDER MUST PROVIDE: WhatsApp Business Cloud API (Meta developer app).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# FOUNDER MUST PROVIDE: Slack app with a bot token (chat:write scope).
SLACK_BOT_TOKEN=

# FOUNDER MUST PROVIDE: HubSpot private app token (per customer, or a HubSpot
# OAuth app for a "Connect HubSpot" flow later).
HUBSPOT_ACCESS_TOKEN=

# FOUNDER MUST PROVIDE: Shopify Admin API access token + store domain (per
# customer, from a custom app on their store).
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_SHOP_DOMAIN=

# --- Public web chat (POST /api/v1/public/chat/{org_public_id}) ---
# The only unauthenticated surface in the product. Defaults below are the
# built-in ones; override only if you need to.
# PUBLIC_CHAT_MAX_MESSAGE_CHARS=2000
# PUBLIC_CHAT_MAX_MESSAGES=60
# PUBLIC_CHAT_IP_LIMIT=20
# PUBLIC_CHAT_IP_WINDOW_SECONDS=300
# PUBLIC_CHAT_CONVERSATION_LIMIT=10
# PUBLIC_CHAT_CONVERSATION_WINDOW_SECONDS=60
# PUBLIC_CHAT_TOKEN_TTL_HOURS=24

# Read the visitor's IP from X-Forwarded-For instead of the socket. Enable this
# ONLY when a proxy that overwrites the header sits in front of the API —
# otherwise any visitor can forge it and walk past the per-IP rate limit.
TRUST_PROXY_HEADERS=false

# FOUNDER MUST PROVIDE: WhatsApp inbound webhook (see docs/needs-founder-input.md §10).
# WHATSAPP_VERIFY_TOKEN is any random string, entered identically here and in
# the Meta dashboard. WHATSAPP_APP_SECRET is the Meta app secret, used to
# validate the X-Hub-Signature-256 header on inbound messages.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Notifications (src/notifications/notifier.py) ---
# "A new approval is waiting on you" alerts. `console` (default) always
# works — it writes a structured log line, no credentials needed. Switch to
# `email` once NOTIFY_EMAIL_PROVIDER_API_KEY is set.
NOTIFY_CHANNEL=console

# FOUNDER MUST PROVIDE to enable email notifications: a transactional-email
# provider key (SendGrid, Postmark, etc). Left blank, the email notifier logs
# a clear "not configured" line and does not send — it never fakes a send.
NOTIFY_EMAIL_PROVIDER_API_KEY=

# Base URL of the dashboard, used to build the link inside a notification
# ("open AURA to approve this").
APP_URL=http://localhost:3000

# --- Workflow engine (src/workflows/) ---
# Scheduled workflows are driven by an asyncio background task inside the API
# process — no Celery, no broker. Running several API instances is safe: each
# due workflow is claimed with a conditional UPDATE that advances its schedule
# in the same statement, so nothing double-fires.
#
# If you'd rather cron owned the schedule, set WORKFLOWS_RUNNER_ENABLED=false
# and run `python -m scripts.run_workflows --once` on a minute cron instead.
# WORKFLOWS_RUNNER_ENABLED=true
# WORKFLOW_TICK_SECONDS=30
# How long a claim held by an instance that died is respected before another
# instance may take the work over.
# WORKFLOW_LOCK_TIMEOUT_SECONDS=600
# Attempts per step, and the base delay for the exponential backoff between them.
# WORKFLOW_STEP_MAX_ATTEMPTS=3
# WORKFLOW_RETRY_BACKOFF_SECONDS=2.0
