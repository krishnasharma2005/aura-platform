# URL of the AURA backend API. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL this dashboard is served from. Used to build the "Add chat to
# your website" script tag (it points at /widget.js on this host). Defaults
# to the browser's current origin if unset, which is fine for local dev.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
